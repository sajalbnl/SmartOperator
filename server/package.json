{
  "name": "smartoperator-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node --import tsx scripts/migrate.ts",
    "reset:demo": "node --import tsx scripts/reset-demo.ts",
    "seed": "node --import tsx scripts/seed.ts",
    "e2e:upload": "node --import tsx scripts/e2e-upload.ts",
    "e2e:pipeline": "node --import tsx scripts/e2e-pipeline.ts",
    "verify:s3": "node --import tsx scripts/verify-s3-multipart.ts",
    "verify:openai": "node --import tsx scripts/verify-openai.ts",
    "verify:anthropic": "node --import tsx scripts/verify-anthropic.ts",
    "verify:ask-prompt": "node --import tsx scripts/verify-ask-prompt.ts",
    "verify:pipeline-retry": "node --import tsx scripts/verify-pipeline-retry.ts",
    "verify:review-decisions": "node --import tsx scripts/verify-review-decisions.ts",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "dotenv": "^17.0.0",
    "express": "^5.0.0",
    "ffmpeg-static": "^5.3.0",
    "multer": "^2.2.0",
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
